            "value": "filter(venues, (((#.status) == (\"down\")) or ((pair in #.pairs) == false) or ((#.kind != \"otc\" or (#.otcHoursUtc.start <= hourUtc and hourUtc < #.otcHoursUtc.end and (not #.otcHoursUtc.weekdaysOnly or not isWeekend))) == false) or ((allowedKinds == \"any\" or #.kind == allowedKinds) == false)) ? (false) : ((((allowSplit) == false) and ((txn.amountUsd > 0 ? #.availableLiquidityUsd / txn.amountUsd : 999) < 1)) ? (false) : ((((allowSplit) == true) and ((#.kind) == (\"otc\")) and ((txn.amountUsd > 0 ? #.availableLiquidityUsd / txn.amountUsd : 999) < 0.5)) ? (false) : ((((allowSplit) == true) and ((#.kind) == (\"exchange\")) and ((txn.amountUsd > 0 ? #.availableLiquidityUsd / txn.amountUsd : 999) < 0.1)) ? (false) : (true)))))"
