    {
      "id": "rank",
      "type": "functionNode",
      "name": "Score & rank",
      "position": {
        "x": 1260,
        "y": 200
      },
      "content": {
        "source": "/** Score & rank eligible venues; build a split plan when strategy is \"split\". */\nexport const handler = async (input) => {\n  const venues = input.eligibleVenues ?? [];\n  const w = input.weights;\n  const amount = input.txn.amountUsd;\n  const round = (n, d) => Math.round(n * 10 ** d) / 10 ** d;\n\n  // min-max normalise to 0..1 (1 = best); identical values all score 1\n  const norm = (vals, v, higherIsBetter) => {\n    const min = Math.min(...vals), max = Math.max(...vals);\n    if (max === min) return 1;\n    return higherIsBetter ? (v - min) / (max - min) : (max - v) / (max - min);\n  };\n  const spreads = venues.map((v) => v.spreadBps);\n  const fills = venues.map((v) => v.fillRate1h);\n  const lats = venues.map((v) => v.latencyP95Ms);\n\n  const rankedVenues = venues\n    .map((v) => {\n      const p = norm(spreads, v.spreadBps, false);\n      const f = norm(fills, v.fillRate1h, true);\n      const l = norm(lats, v.latencyP95Ms, false);\n      let score = w.price * p + w.fill * f + w.latency * l;\n      const reasons = [\n        `spread ${v.spreadBps}bps (price ${round(p, 2)})`,\n        `fill rate ${round(v.fillRate1h * 100, 1)}% (fill ${round(f, 2)})`,\n        `p95 latency ${v.latencyP95Ms}ms (latency ${round(l, 2)})`,\n      ];\n      if (v.status === 'degraded') { score *= 0.85; reasons.push('degraded: score x0.85'); }\n      return {\n        id: v.id, kind: v.kind, status: v.status, spreadBps: v.spreadBps,\n        availableLiquidityUsd: v.availableLiquidityUsd, score: round(score, 4), reasons,\n      };\n    })\n    .sort((a, b) => b.score - a.score || a.id.localeCompare(b.id));\n\n  const out = { rankedVenues, fallbackChain: rankedVenues.map((v) => v.id) };\n\n  if (input.strategy === 'split' && rankedVenues.length > 0) {\n    // proportional to available liquidity across the top 3, capped at each venue's liquidity;\n    // slices under 5% of the order are dropped and the rest re-balanced.\n    let pool = rankedVenues.slice(0, 3);\n    const allocate = (p) => {\n      const total = p.reduce((s, v) => s + v.availableLiquidityUsd, 0);\n      const ratio = Math.min(1, amount / total);\n      return p.map((v) => ({ id: v.id, amountUsd: round(v.availableLiquidityUsd * ratio, 2) }));\n    };\n    let alloc = allocate(pool);\n    const kept = alloc.filter((a) => a.amountUsd >= amount * 0.05).map((a) => a.id);\n    if (kept.length > 0 && kept.length < alloc.length) {\n      pool = pool.filter((v) => kept.includes(v.id));\n      alloc = allocate(pool);\n    }\n    const allocated = alloc.reduce((s, a) => s + a.amountUsd, 0);\n    out.splitPlan = {\n      allocations: alloc.map((a) => ({ ...a, share: round(a.amountUsd / amount, 4) })),\n      unallocatedUsd: round(Math.max(0, amount - allocated), 2),\n    };\n  }\n  return { ...input, ...out };\n};\n"
      }
